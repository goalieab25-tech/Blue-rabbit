<script>
(function(){
  const body=document.body;
  function buildTabs(){
    const tabs=document.getElementById('tabs'), cats=[...document.querySelectorAll('[data-cat]')];
    tabs.innerHTML='';
    cats.forEach((c,i)=>{const b=document.createElement('button');b.className='tab';b.type='button';b.setAttribute('role','tab');
      b.textContent=c.querySelector('.cat-head h3').textContent.trim()||'Section';b.onclick=()=>select(i);tabs.appendChild(b);});
    select(0);
  }
  function select(i){
    document.querySelectorAll('.tab').forEach((t,j)=>t.setAttribute('aria-selected',i===j));
    document.querySelectorAll('[data-cat]').forEach((c,j)=>c.classList.toggle('active',i===j));
  }
  function fillTicker(){
    const t=document.getElementById('ticker');
    t.querySelectorAll('[data-clone]').forEach(n=>n.remove());
    [...t.children].forEach(n=>{const c=n.cloneNode(true);c.dataset.clone='1';c.removeAttribute('data-edit');c.removeAttribute('contenteditable');t.appendChild(c);});
  }
  function syncLinks(){
    const addr=document.getElementById('addr').textContent.trim();
    const url='https://www.google.com/maps/search/?api=1&query='+encodeURIComponent('Blue Rabbit Bar and Grill, '+addr);
    document.querySelectorAll('[data-map]').forEach(a=>{a.href=url;a.target='_blank';a.rel='noopener';});
  }
  const X='<button class="x ed-only" aria-label="Remove">×</button>';
  const T={
    item:()=>`<div class="item">${X}<div class="item-top"><span class="item-name" data-edit>New item</span><span class="dots"></span><span class="price" data-edit>$0</span></div><p class="item-desc" data-edit>Description</p></div>`,
    cat:()=>`<div class="cat" data-cat><div class="cat-head"><h3 data-edit>New Section</h3><p data-edit>Short note</p></div><div class="items">${T.item()}</div><button class="add ed-only" data-add="item">+ Add item</button></div>`
  };
  const html=s=>{const d=document.createElement('div');d.innerHTML=s;return d.firstElementChild;};
  const editing=()=>body.classList.contains('editing');

  // photo swapping
  const pick=document.getElementById('imgPick'); let target=null;
  pick.onchange=()=>{const f=pick.files[0]; if(!f||!target) return;
    const r=new FileReader(); r.onload=()=>{target.src=r.result;}; r.readAsDataURL(f); pick.value='';};

  document.addEventListener('click',e=>{
    if(!editing()) return;
    const img=e.target.closest('[data-img]'); if(img){e.preventDefault();target=img;pick.click();return;}
    const ln=e.target.closest('a'); if(ln&&!ln.hasAttribute('download')) e.preventDefault();
    const x=e.target.closest('.x'); if(x){x.parentElement.remove();return;}
    const add=e.target.closest('[data-add]'); if(!add) return;
    let el;
    if(add.dataset.add==='item'){el=html(T.item());add.parentElement.querySelector('.items').appendChild(el);}
    else {el=html(T.cat());document.getElementById('cats').appendChild(el);}
    setEditable(true);
    const f=el.querySelector('[data-edit]');f.focus();const r=document.createRange();r.selectNodeContents(f);getSelection().removeAllRanges();getSelection().addRange(r);
  });
  function setEditable(on){document.querySelectorAll('[data-edit]').forEach(el=>on?el.setAttribute('contenteditable','true'):el.removeAttribute('contenteditable'));}
  document.addEventListener('paste',e=>{if(!e.target.closest('[contenteditable]'))return;e.preventDefault();document.execCommand('insertText',false,e.clipboardData.getData('text'));});
  document.addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target.closest('[contenteditable]')){e.preventDefault();e.target.blur();}});

  const toggle=document.getElementById('editToggle');
  toggle.onclick=()=>{
    const on=!editing(); body.classList.toggle('editing',on); setEditable(on);
    toggle.textContent=on?'Done':'Edit';
    if(on) document.querySelectorAll('#ticker [data-clone]').forEach(n=>n.remove());
    else {syncLinks();buildTabs();fillTicker();}
  };
  document.getElementById('saveBtn').onclick=()=>{
    syncLinks();
    const c=document.documentElement.cloneNode(true);
    c.querySelector('body').classList.remove('editing');
    c.querySelectorAll('[contenteditable]').forEach(n=>n.removeAttribute('contenteditable'));
    c.querySelectorAll('#ticker [data-clone]').forEach(n=>n.remove());
    c.querySelector('#tabs').innerHTML='';
    c.querySelectorAll('.cat.active').forEach(n=>n.classList.remove('active'));
    c.querySelector('#editToggle').textContent='Edit';
    const a=document.createElement('a');
    a.href=URL.createObjectURL(new Blob(['<!DOCTYPE html>\n'+c.outerHTML],{type:'text/html'}));
    a.download='blue-rabbit-website.html';document.body.appendChild(a);a.click();a.remove();
  };
  // Add ?public to the URL to hide the Edit button for visitors.
  if(/[?&]public\b/.test(location.search)) document.querySelector('.editbar').remove();
  syncLinks();buildTabs();fillTicker();
})();
</script>


