<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Blue Rabbit Bar &amp; Grill</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&amp;family=Nunito:wght@900&amp;family=Source+Sans+3:wght@400;600;700&amp;display=swap" rel="stylesheet">
<style>
:root{--bg:#07111f;--bg2:#0c1b30;--card:#10223b;--line:#1f3a5f;--blue:#1f6fff;--blue-2:#5aa7ff;--gold:#ffc53d;--text:#eef4ff;--muted:#a9bbd6;--on-gold:#1a1300;--max:1180px}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font:400 17px/1.6 "Source Sans 3",system-ui,sans-serif;-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:"Bebas Neue",Impact,"Arial Narrow",sans-serif;font-weight:400;letter-spacing:.02em;line-height:1;margin:0}
a{color:inherit}
img{display:block;max-width:100%}
.wrap{max-width:var(--max);margin:0 auto;padding:0 20px}
section{padding:80px 0}
.sec-title{font-size:clamp(48px,7vw,80px)}
.btn{display:inline-flex;align-items:center;min-height:50px;padding:0 26px;border-radius:999px;font-weight:700;text-decoration:none;border:2px solid transparent;cursor:pointer;transition:transform .2s;font-size:16px}
.btn:hover{transform:translateY(-2px)}
.btn-gold{background:var(--gold);color:var(--on-gold)}
.btn-ghost{border-color:rgba(255,255,255,.6);color:#fff}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px}

/* NAV */
.nav{position:absolute;top:0;left:0;right:0;z-index:40}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:84px}
.logo{display:flex;align-items:center;gap:6px;text-decoration:none}
.logo svg{width:52px;height:52px;flex:none;filter:drop-shadow(0 2px 6px rgba(0,0,0,.4))}
.logo .word{font:900 30px/1 "Nunito",system-ui,sans-serif;color:#fff;letter-spacing:-.02em;text-shadow:0 2px 8px rgba(0,0,0,.5)}
.logo .word b{color:var(--blue-2);font-weight:900}
.nav-links{display:flex;gap:24px;align-items:center}
.nav-links a{text-decoration:none;font-weight:700;color:#fff}
@media(max-width:640px){.nav-links a:not(.btn){display:none}.logo .word{font-size:24px}.logo svg{width:42px;height:42px}}

/* HERO */
.hero{position:relative;min-height:92vh;display:flex;align-items:flex-end;padding:120px 0 72px;background:#000}
.hero > img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 25%;opacity:.6}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(7,17,31,.7) 0%,transparent 22%,transparent 38%,rgba(7,17,31,.85) 62%,var(--bg) 100%)}
.hero .wrap{position:relative;z-index:1;width:100%}
.hero h1{font-size:clamp(56px,8.5vw,120px)}
.hero h1 .blue{color:var(--blue-2)}
.hero .sub{font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin:14px 0 28px}
.ctas{display:flex;gap:12px;flex-wrap:wrap}

/* TICKER */
.ticker{background:var(--gold);color:var(--on-gold);overflow:hidden;white-space:nowrap}
.ticker-track{display:inline-flex;gap:48px;padding:12px 0;animation:scroll 30s linear infinite;font-family:"Bebas Neue",Impact,sans-serif;font-size:26px;letter-spacing:.06em}
.ticker-track span::before{content:"\2605";margin-right:16px}
@keyframes scroll{to{transform:translateX(-50%)}}

/* PHOTOS */
.photos{display:grid;grid-template-columns:2fr 1fr 1fr;grid-template-rows:280px 280px;gap:12px}
.photos figure{margin:0;position:relative;overflow:hidden;border-radius:16px;background:var(--card)}
.photos figure:first-child{grid-row:1/3}
.photos img{width:100%;height:100%;object-fit:cover;transition:transform .4s}
.photos figure:hover img{transform:scale(1.04)}
@media(max-width:760px){.photos{grid-template-columns:1fr 1fr;grid-template-rows:auto}.photos figure{height:200px}.photos figure:first-child{grid-column:1/3;grid-row:auto;height:280px}}

/* MENU */
#menu{background:var(--bg2)}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:28px 0}
.tab{min-height:44px;padding:0 18px;border-radius:999px;border:1px solid var(--line);background:transparent;color:var(--muted);font:700 15px "Source Sans 3",system-ui,sans-serif;cursor:pointer;transition:all .2s}
.tab:hover{color:var(--text);border-color:var(--blue)}
.tab[aria-selected="true"]{background:var(--blue);border-color:var(--blue);color:#fff}
.cat{display:none}.cat.active{display:block}
.cat-head{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:8px}
.cat-head h3{font-size:46px}
.cat-head p{color:var(--muted);margin:0}
.items{display:grid;grid-template-columns:1fr 1fr;gap:0 48px}
@media(max-width:760px){.items{grid-template-columns:1fr}}
.item{position:relative;padding:18px 0;border-bottom:1px solid var(--line)}
.item-top{display:flex;align-items:baseline;gap:10px}
.item-name{font-weight:700;font-size:19px}
.dots{flex:1;border-bottom:2px dotted var(--line);transform:translateY(-5px);min-width:20px}
.price{font-family:"Bebas Neue",Impact,sans-serif;font-size:26px;color:var(--gold)}
.item-desc{color:var(--muted);margin:4px 0 0;font-size:16px}
.menu-note{color:var(--muted);font-size:14px;margin-top:28px}
.sec-sub,#menu .eyebrow{display:none}

/* VISIT */
.visit{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
.visit figure{margin:0;border-radius:16px;overflow:hidden;aspect-ratio:4/5}
.visit figure img{width:100%;height:100%;object-fit:cover}
.facts{display:grid;gap:22px;margin:28px 0 32px}
.facts .label{display:block;font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}
.facts .val{font-size:22px;font-weight:600}
@media(max-width:820px){.visit{grid-template-columns:1fr}.visit figure{aspect-ratio:4/3}}

footer{border-top:1px solid var(--line);padding:28px 0;color:var(--muted);font-size:15px;text-align:center}

/* EDITOR */
.ed-only{display:none!important}
body.editing .ed-only{display:inline-flex!important}
body.editing [data-edit]{outline:1.5px dashed rgba(255,197,61,.6);outline-offset:3px;border-radius:4px;cursor:text}
body.editing [data-edit]:focus{outline:2px solid var(--gold)}
body.editing [data-img]{cursor:pointer;outline:3px dashed var(--gold);outline-offset:-3px}
body.editing .cat{display:block;margin-bottom:48px}
body.editing .tabs{display:none}
.x{position:absolute;top:14px;right:0;width:30px;height:30px;border-radius:50%;border:1px solid #ff4d4d;background:#2a0f14;color:#ff4d4d;font-weight:700;cursor:pointer;align-items:center;justify-content:center;z-index:2}
.add{min-height:40px;padding:0 16px;border-radius:999px;border:1.5px dashed var(--gold);background:transparent;color:var(--gold);font:700 14px "Source Sans 3",system-ui,sans-serif;cursor:pointer;margin-top:14px;align-items:center}
.editbar{position:fixed;right:18px;bottom:18px;z-index:60;display:flex;gap:10px}
.editbar button{display:inline-flex;align-items:center;min-height:48px;padding:0 20px;border-radius:999px;border:0;font:700 15px "Source Sans 3",system-ui,sans-serif;cursor:pointer;box-shadow:0 10px 30px rgba(0,0,0,.4)}
#editToggle{background:var(--blue);color:#fff}
body.editing #editToggle{background:#fff;color:#07111f}
#saveBtn{background:var(--gold);color:var(--on-gold)}
.item .x{top:14px;right:-40px}@media(max-width:1260px){.item .x{right:0;top:-6px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
